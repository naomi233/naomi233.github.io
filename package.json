{
  "name": "vuepress-theme-hope-template",
  "version": "2.0.0",
  "private": true,
  "description": "A project of vuepress-theme-hope",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vuepress-vite build docs",
    "clean-dev": "vuepress-vite dev docs --clean-cache",
    "dev": "vuepress-vite dev docs",
    "postinstall": "npx simple-git-hooks",
    "lint-md": "lint-md --fix \"docs/**/*.md\"",
    "prettier": "prettier -w .",
    "update-package": "pnpm dlx vp-update"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,scss,md}": "prettier -w",
    "*.md": "lint-md --fix"
  },
  "devDependencies": {
    "@lint-md/cli": "^2.3.1",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-back-to-top": "2.0.0-rc.131",
    "@vuepress/plugin-feed": "2.0.0-rc.132",
    "@vuepress/plugin-markdown-hint": "2.0.0-rc.132",
    "@vuepress/plugin-markdown-tab": "2.0.0-rc.132",
    "@vuepress/plugin-redirect": "2.0.0-rc.131",
    "@vuepress/plugin-search": "2.0.0-rc.131",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-compact-markdown-table": "^0.1.0",
    "sass-embedded": "^1.103.1",
    "simple-git-hooks": "^2.14.0",
    "vue": "^3.5.42",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  }
}
